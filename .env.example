# Скопируй в .env (локально) или внеси в панель хостинга. НИКОГДА не коммить .env в GitHub.

# Токен от @BotFather (/newbot)
BOT_TOKEN=123456:ABC-your-token

# Юзернейм бота без @ и короткое имя Mini App из /newapp (нужны для реферальных ссылок)
BOT_USERNAME=GoblinEmpireBot
APP_SHORT_NAME=play

# Длинная случайная строка (минимум 32 символа). Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-32chars-min

# Строка подключения к PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/goblin
# true — если провайдер БД требует SSL (Neon, Supabase, внешний URL Render)
DB_SSL=false

# Публичный https-адрес сервиса (на Render подставится автоматически через RENDER_EXTERNAL_URL)
PUBLIC_URL=https://your-app.onrender.com

PORT=3000
